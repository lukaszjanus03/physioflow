{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "TwoFactor": {
    "Issuer": "PhysioFlow",
    "ChallengeLifetimeSeconds": 300,
    "SetupLifetimeSeconds": 600,
    "MaxFailedAttempts": 5,
    "LockoutSeconds": 300,
    "RecoveryCodeCount": 10
  },
  "Chat": {
    "MessagesPerMinute": 30
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "ConfirmationEmail": {
    "CooldownSeconds": 60
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 20,
      "WindowMinutes": 15
    },
    "TwoFactor": {
      "PermitLimit": 60,
      "WindowMinutes": 15
    },
    "TherapistReviewWrite": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "PublicTherapistCatalog": {
      "PermitLimit": 120,
      "WindowMinutes": 1
    },
    "PatientRegistration": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "EmailConfirmation": {
      "PermitLimit": 10,
      "WindowMinutes": 15
    },
    "ConfirmationResend": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "CooperationRequest": {
      "PermitLimit": 20,
      "WindowMinutes": 15
    }
  },
  "AppointmentReminders": {
    "Enabled": false,
    "PollIntervalSeconds": 60,
    "BatchSize": 100,
    "MaxAttempts": 3,
    "RetryDelayMinutes": 5
  },
  "CooperationRequests": {
    "RejectionCooldownDays": 7,
    "WithdrawalCooldownMinutes": 60,
    "MaxRequestsPerDay": 10
  }
}
