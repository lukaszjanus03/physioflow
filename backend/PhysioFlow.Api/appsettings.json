{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "ConfirmationEmail": {
    "CooldownSeconds": 60
  },
  "RateLimiting": {
    "PatientRegistration": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "EmailConfirmation": {
      "PermitLimit": 10,
      "WindowMinutes": 15
    },
    "ConfirmationResend": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "CooperationRequest": {
      "PermitLimit": 20,
      "WindowMinutes": 15
    }
  },
  "AppointmentReminders": {
    "Enabled": false,
    "PollIntervalSeconds": 60,
    "BatchSize": 100,
    "MaxAttempts": 3,
    "RetryDelayMinutes": 5
  },
  "CooperationRequests": {
    "RejectionCooldownDays": 7,
    "WithdrawalCooldownMinutes": 60,
    "MaxRequestsPerDay": 10
  }
}
