{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "RateLimiting": {
    "PatientRegistration": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    }
  }
}
